{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  },
  "permissions": {
    "allow": [
      "Bash(node --check *)",
      "Bash(node --test .github/scripts/stats-cards/*)",
      "Bash(npx prettier@3 *)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git branch*)"
    ],
    "deny": ["Read(./.env)", "Read(./.env.*)"]
  }
}
